TEST;

JUMP start;



LABEL start;

LABEL i;
WRITEREG 0 10;
LABEL j;
WRITEREG 1 5;

LABEL imax;
WRITEREG 2 26;
LABEL jmax;
LABEL note: off by one, needs to be fixed in some way;
WRITEREG 3 13;

LABEL subR;
WRITEREG 4 16;
LABEL subG;
WRITEREG 5 36;

LABEL inc;
WRITEREG 6 1;

WRITEREG R 255;
WRITEREG G 255;
WRITEREG B 0;

JUMP loop;



LABEL loop;
    WRITESCREEN 0 1;
    SUB R 4;
    ADD 0 6;

    COPY 7 2;
    SUB 7 0;

    JUMPZERO 7 doneInner;
JUMP loop;

LABEL doneInner;
    SUB G 5;
    ADD 1 6;

    WRITEREG 0 10;

    COPY 7 3;
    SUB 7 1;

    JUMPZERO 7 done;
JUMP loop;



LABEL done;
PROGEND;